# ==============================================================
# Vitahar Environment Configuration Template
# ==============================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit the actual .env file).
# 2. Fill in your real configuration values and API keys below.
# ==============================================================

# AI / OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=vitahar_db
DB_USER=root
DB_PASS=your_database_password_here

# Admin Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Email / Feedback Service (Brevo - formerly Sendinblue)
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
FEEDBACK_RECEIVER_EMAIL=your_email@example.com
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Vitahar
